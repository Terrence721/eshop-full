{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean stale .NET build servers",
      "type": "shell",
      "command": "node scripts/clean-build-servers.mjs",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build ClientApp",
      "type": "shell",
      "command": "dotnet build src/ClientApp/ClientApp.csproj -f net10.0",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
