{
  "name": "eshop",
  "version": "1.0.0",
  "private": true,
  "description": "A reference .NET application implementing an eCommerce web site using a services-based architecture.",
  "directories": {
    "test": "tests"
  },
  "workspaces": [
    "src/Identity.WebApp",
    "src/WebhookClient.WebApp",
    "src/WebApp"
  ],
  "resolutions": {
    "undici": "^8.10.2",
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "clean:logs": "node scripts/clean-logs.mjs",
    "clean:build-servers": "node scripts/clean-build-servers.mjs",
    "unlock:build": "node scripts/unlock-build.mjs",
    "build": "yarn unlock:build && dotnet build eShop.slnx /nr:false",
    "build:clientapp": "dotnet build src/ClientApp/ClientApp.csproj -f net10.0",
    "run:clientapp:desktop": "dotnet run --project src/ClientApp.Desktop/ClientApp.Desktop.csproj",
    "run:clientapp:android:emulator": "\"%LOCALAPPDATA%\\Android\\Sdk\\emulator\\emulator.exe\" -avd eShop_Emulator",
    "run:clientapp:android": "dotnet build src/ClientApp.Android/ClientApp.Android.csproj -c Release -p:RuntimeIdentifier=android-x64 -t:Run",
    "run:clientapp:browser:publish": "dotnet publish src/ClientApp.Browser/ClientApp.Browser.csproj -c Release",
    "run:clientapp:browser:serve": "python -m http.server 8080 --directory artifacts/publish/ClientApp.Browser/release/wwwroot",
    "run:clientapp:all": "pwsh -NoProfile -File scripts/Run-ClientApps.ps1 -All"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7"
  }
}
