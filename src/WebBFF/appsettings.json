{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "eventbus": "amqp://localhost"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/remoteapi/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/remoteapi/catalog" } ],
        "Metadata": { "Duende.Bff.Yarp.TokenType": "None" }
      },
      "basket": {
        "ClusterId": "basket",
        "Match": { "Path": "/remoteapi/basket/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/remoteapi/basket" } ],
        "Metadata": { "Duende.Bff.Yarp.TokenType": "UserOrNone" }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/remoteapi/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/remoteapi/orders" } ],
        "Metadata": { "Duende.Bff.Yarp.TokenType": "User" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5222" }
        }
      },
      "basket": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5231" }
        }
      },
      "orders": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5224" }
        }
      }
    }
  }
}
