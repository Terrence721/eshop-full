<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>eShop.EventBusKafka</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ActivityExtensions.cs" Link="ActivityExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Confluent.Kafka" />
    <PackageReference Include="Confluent.Kafka" />
    <!-- Polly.Core, not via Aspire.Confluent.Kafka transitively (unlike EventBusRabbitMQ, where
         it rides in via Aspire.RabbitMQ.Client), pinned to the same version already resolved
         transitively everywhere else in the solution, confirmed against EventBusRabbitMQ's own
         project.assets.json, so this doesn't introduce a second Polly version. -->
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventBus\EventBus.csproj" />
  </ItemGroup>

</Project>
