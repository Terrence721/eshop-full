<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <AppIcon>AppIcon</AppIcon>
    <ApplicationId>com.companyname.eshop</ApplicationId>
    <!-- .NET for iOS runs IL trimming as part of its own build pipeline (not a Release-only
         publish concern the way it is on other platforms), and this repo's global
         TreatWarningsAsErrors escalates the resulting trim-safety warnings into build
         failures. IL2026 was ViewLocator's reflection-based resolution (now a trim-safe
         explicit registry, see ViewLocator.cs, so no longer needed); IL2104 is a real,
         known, documented limitation, not a bug: Avalonia.DesignerSupport,
         AvaloniaUI.DiagnosticsSupport, Google.Protobuf, and Microsoft.IO.RecyclableMemoryStream
         simply aren't trim-annotated libraries. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientApp\ClientApp.csproj" />
  </ItemGroup>

</Project>
