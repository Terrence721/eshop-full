<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eShop.ClientApp.ViewModels"
        x:Class="eShop.ClientApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="eShop"
        Icon="avares://ClientApp/Assets/app-icon-draft.png"
        Background="#2556CB">
    <TextBlock Text="{Binding Greeting}"
               Foreground="White"
               FontSize="24"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
</Window>
