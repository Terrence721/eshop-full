<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eShop.ClientApp.ViewModels"
             x:Class="eShop.ClientApp.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Foreground="White">
    <Grid Background="White" RowDefinitions="Auto,*,Auto,Auto,*">
        <Image Grid.Row="0" Grid.RowSpan="5"
               Source="avares://ClientApp/Assets/eshop_homepage.png"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <Button Grid.Row="0" Grid.RowSpan="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#6600FF00"
                BorderThickness="0"
                Click="OnImageClick" />

        <DropDownButton Grid.Row="0"
                         Content="Settings"
                         HorizontalAlignment="Right"
                         Margin="16"
                         Background="Black"
                         Foreground="White">
            <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Command="{Binding SettingsCommand}">
                        <MenuItem.Header>
                            <TextBlock Text="Settings" Foreground="#4EA1F7" TextDecorations="Underline" />
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="OnQuitClick">
                        <MenuItem.Header>
                            <TextBlock Text="Close" Foreground="#4EA1F7" TextDecorations="Underline" />
                        </MenuItem.Header>
                    </MenuItem>
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>

        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     HorizontalAlignment="Center"
                     Width="200" />

        <Border Grid.Row="0" Grid.RowSpan="5"
                IsVisible="{Binding LoginModalVisible}"
                Background="#B0000000"
                Padding="24">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320"
                        Background="#FFFFFF"
                        Margin="16">
                <TextBlock Text="Sign in" FontSize="18" Margin="0,0,0,12" />
                <StackPanel IsVisible="{Binding ShowLoginForm}">
                    <TextBox Text="{Binding UserName.Value}"
                             PlaceholderText="Username"
                             Margin="0,0,0,8" />
                    <TextBox Text="{Binding Password.Value}"
                             PasswordChar="*"
                             Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CloseLoginModalCommand}" />
                        <Button Content="Log in"
                                Command="{Binding MockSignInCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding LoginSuccessful}">
                    <TextBlock Text="Login successful" FontWeight="Bold" Margin="0,0,0,12" />
                    <Button Content="Continue"
                            Command="{Binding ContinueAfterLoginCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
