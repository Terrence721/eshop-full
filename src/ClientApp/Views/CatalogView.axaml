<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eShop.ClientApp.ViewModels"
             x:Class="eShop.ClientApp.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
    <Grid x:Name="RootGrid" Background="White">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto">
            <Image Source="avares://ClientApp/Assets/eshop_homepage.png"
                   Width="{Binding Bounds.Width, ElementName=RootGrid}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top" />
        </ScrollViewer>
    </Grid>
</UserControl>