<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eShop.ClientApp.ViewModels"
             xmlns:models="using:eShop.ClientApp.Models.Catalog"
             xmlns:templates="using:eShop.ClientApp.Views.Templates"
             x:Class="eShop.ClientApp.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
    <Grid x:Name="RootGrid" Background="White">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto">
            <Image Source="avares://ClientApp/Assets/eshop_homepage.png"
                   Width="{Binding Bounds.Width, ElementName=RootGrid}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top" />
        </ScrollViewer>

        <Button x:Name="AvatarHit"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,36,170,0"
                Width="100"
                Height="50"
                Background="Transparent"
                BorderThickness="0"
                Click="OnAvatarClick" />

        <Button x:Name="AllCatalogHotspot"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="60,600,0,0"
                Width="60"
                Height="24"
                Background="#01FFFFFF"
                BorderThickness="0"
                Click="OnAllCatalogClick" />

        <Border x:Name="CatalogModal"
                IsVisible="{Binding IsCatalogOverlayVisible}"
                Background="#B0000000"
                Padding="24">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    Padding="24"
                    CornerRadius="8"
                    MinWidth="360"
                    MaxHeight="600">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="Catalog"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CatalogItem">
                                    <templates:CatalogItemTemplate />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2"
                            Content="Close"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Click="OnCloseCatalogOverlay" />
                </Grid>
            </Border>
        </Border>

        <Border x:Name="LoginModal"
                IsVisible="False"
                Background="#80000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    Padding="24"
                    CornerRadius="8"
                    MinWidth="280">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sign in"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBox x:Name="UsernameBox"
                             PlaceholderText="Username"
                             Width="280" />
                    <TextBox x:Name="PasswordBox"
                             PlaceholderText="Password"
                             PasswordChar="*"
                             Width="280" />
                    <TextBlock x:Name="StatusText"
                               Foreground="Red"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Cancel" Click="OnCancelLogin" />
                        <Button Content="Log in" Click="OnSignIn" />
                    </StackPanel>
                    <TextBlock x:Name="SuccessText"
                               Text=""
                               FontWeight="Bold"
                               Foreground="Green" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>