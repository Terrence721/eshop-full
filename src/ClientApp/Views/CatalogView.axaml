<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:eShop.ClientApp.ViewModels"
             xmlns:models="using:eShop.ClientApp.Models.Catalog"
             xmlns:templates="using:eShop.ClientApp.Views.Templates"
             x:Class="eShop.ClientApp.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
    <Grid x:Name="RootGrid" Background="White">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto">
            <Image x:Name="RootImage"
                   Source="avares://ClientApp/Assets/eshop_homepage.png"
                   Width="{Binding Bounds.Width, ElementName=RootGrid}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top" />
        </ScrollViewer>

        <Border x:Name="CatalogOverlay"
                IsVisible="{Binding IsCatalogOverlayVisible}"
                Background="#B0000000"
                Padding="24"
                PointerPressed="OnCatalogOverlayPressed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    Padding="24"
                    CornerRadius="8"
                    MinWidth="420"
                    MaxHeight="640">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Text="Catalog"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,12,0,12">
                        <ComboBox ItemsSource="{Binding Brands}"
                                  SelectionChanged="OnBrandFilterChanged"
                                  Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:CatalogBrandSelectionViewModel">
                                    <TextBlock Text="{Binding Value.Brand}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding Types}"
                                  SelectionChanged="OnTypeFilterChanged"
                                  Width="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:CatalogTypeSelectionViewModel">
                                    <TextBlock Text="{Binding Value.Type}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CatalogItem">
                                    <templates:CatalogItemTemplate />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="3"
                            Content="Close"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Click="OnCloseCatalogOverlay" />
                </Grid>
            </Border>
        </Border>

        <Border x:Name="LoginModal"
                IsVisible="False"
                Background="#80000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFFFF"
                    Padding="24"
                    CornerRadius="8"
                    MinWidth="280">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sign in"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBox x:Name="UsernameBox"
                             PlaceholderText="Username"
                             Width="280" />
                    <TextBox x:Name="PasswordBox"
                             PlaceholderText="Password"
                             PasswordChar="*"
                             Width="280" />
                    <TextBlock x:Name="StatusText"
                               Foreground="Red"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Cancel" Click="OnCancelLogin" />
                        <Button Content="Log in" Click="OnSignIn" />
                    </StackPanel>
                    <TextBlock x:Name="SuccessText"
                               Text=""
                               FontWeight="Bold"
                               Foreground="Green" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>